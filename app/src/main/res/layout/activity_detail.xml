<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/wallpaper"

    tools:context=".DetailActivity">


    <!-- GAMBAR SMART CITY -->

    <ImageView
        android:id="@+id/imageView2"

        android:layout_width="285dp"
        android:layout_height="192dp"

        android:layout_marginTop="40dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:srcCompat="@drawable/smartcity" />


    <!-- JUDUL PROJECT -->

    <TextView
        android:id="@+id/judulprojek"

        style="@style/AnimeTextStyle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:text="Smart City"

        android:textColor="@color/silver"

        android:textSize="40sp"
        android:textStyle="bold"

        android:shadowRadius="5"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/imageView2" />


    <!-- DESKRIPSI PROJECT -->

    <TextView
        android:id="@+id/deskjudul"

        style="@style/AnimeTextStyle"

        android:layout_width="353dp"
        android:layout_height="205dp"

        android:layout_marginTop="20dp"

        android:text="@string/deskripsijudul"

        android:textAlignment="center"

        android:textColor="@color/silver"

        android:textSize="14sp"

        android:textStyle="bold"

        android:shadowRadius="5"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/judulprojek" />


    <!-- BUTTON KEMBALI -->

    <Button
        android:id="@+id/btn_kembali1"

        style="@style/AnimeButton"

        android:layout_width="145dp"
        android:layout_height="51dp"

        android:layout_marginTop="75dp"

        android:backgroundTint="@color/cyan_registrasi"

        android:text="@string/btn_kembali"

        android:textColor="@color/silver"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/deskjudul" />


</androidx.constraintlayout.widget.ConstraintLayout>